# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Database
SQLALCHEMY_DATABASE_URI=sqlite:///barter.db

# Mail Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=Your App Name,your-email@gmail.com

# BarterXpress Valuator microservice (the standalone AI valuation API
# in ../barterxpress-valuator — see valuator_client.py). Run it with
# `python run.py` (defaults to port 5001 so it doesn't collide with
# this app's own dev server on port 5000).
VALUATOR_API_URL=http://localhost:5001
VALUATOR_API_TIMEOUT=20
