# Copy this file to .env and fill in deployment-specific values.

# Flask Configuration
# Generate separate random values of at least 32 characters; do not use examples.
SECRET_KEY=
# Keep stable across SECRET_KEY rotations (used only for verified-identity deduplication).
IDENTITY_HASH_KEY=T5TUSjgt16z6zUUpai7MXONM8CUq0XOtriHCnV75XdvHLfPqSt7xGB8MiDIScj6z
FLASK_ENV=development
# Public origin used for notification links rendered by background workers.
APP_URL=https://barterxpress.com

# Database
SQLALCHEMY_DATABASE_URI=sqlite:///barter.db

# Mail Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=Your App Name,your-email@gmail.com
EMAIL_LOGO_URL=https://barterxpress.com/static/logo.png

# AI Valuator (separate service). Leave VALUATOR_API_URL empty to switch the feature off.
VALUATOR_API_URL=http://127.0.0.1:5001
VALUATOR_API_KEY=same-key-as-the-valuator-VALUATOR_API_KEY
VALUATOR_API_TIMEOUT=120
VALUATOR_ENABLED=true
VALUATOR_MAX_PARALLEL=2

# Activate for Trade: temp video storage (leave GCS_BUCKET_NAME empty to switch the feature off)
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# Alternative to a key file (e.g. if your org blocks key creation): leave
# GOOGLE_APPLICATION_CREDENTIALS empty, run `gcloud auth application-default login`,
# and set this to the bucket's service account email to impersonate it instead.
GCS_SERVICE_ACCOUNT_EMAIL=
GCS_SIGNED_URL_MINUTES=20

# Activate for Trade: YouTube publishing (run get_youtube_refresh_token.py to get the refresh token)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ENABLED=true
# Recommended: pin verification to the official channel ID (UC...).
YOUTUBE_CHANNEL_ID=
